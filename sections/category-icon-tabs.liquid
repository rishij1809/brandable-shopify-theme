<section class="igp-category-circles-section">
  <div class="container">
    <div class="igp-section-heading">
      <h2>Explore Corporate Gifting Categories</h2>
      <p>Curated collections, handcrafted luxury hampers, and customizable brand merchandise</p>
    </div>

    <div class="igp-circles-scroll">
      <!-- 1. All Hampers -->
      <a href="/collections/all" class="igp-circle-card active">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=180&q=80" alt="All Hampers" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">All Hampers</span>
      </a>

      <!-- 2. Custom Boxes -->
      <a href="/#box-builder" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1513297887119-d46091b24bfa?auto=format&fit=crop&w=180&q=80" alt="Custom Boxes" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Build a Box</span>
      </a>

      <!-- 3. Drinkware & Flasks -->
      <a href="/collections/all/drinkware" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=180&q=80" alt="Drinkware & Flasks" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Drinkware</span>
      </a>

      <!-- 4. Diaries & Journals -->
      <a href="/collections/all/diaries" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=180&q=80" alt="Diaries & Stationary" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Diaries & Pens</span>
      </a>

      <!-- 5. Apparel & T-Shirts -->
      <a href="/collections/all/apparel" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=180&q=80" alt="Apparel & Swag" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Apparel & Swag</span>
      </a>

      <!-- 6. Tech & Gadgets -->
      <a href="/collections/all/tech" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=180&q=80" alt="Tech Accessories" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Tech & Audio</span>
      </a>

      <!-- 7. Gourmet Treats -->
      <a href="/collections/all/gourmet" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1543257580-7269da773bf5?auto=format&fit=crop&w=180&q=80" alt="Artisan Treats" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Chocolates & Tea</span>
      </a>

      <!-- 8. Eco & Wellness -->
      <a href="/collections/all/eco" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1485955900006-10f4d324d411?auto=format&fit=crop&w=180&q=80" alt="Plants & Eco Gifts" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Plants & Eco</span>
      </a>

      <!-- 9. Executive Kits -->
      <a href="/collections/all/employee-onboarding" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=180&q=80" alt="Employee Onboarding" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Onboarding Kits</span>
      </a>
    </div>
  </div>
</section>

