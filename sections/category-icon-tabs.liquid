        </div>
        <span class="igp-circle-label">Executive Combos</span>
      </a>

      <!-- 5. Drinkware & Flasks -->
      <a href="/collections/all/drinkware" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=180&q=80" alt="Drinkware & Flasks" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Drinkware & Flasks</span>
      </a>

      <!-- 6. Diaries & Journals -->
      <a href="/collections/all/diaries" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=180&q=80" alt="Diaries & Stationary" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Diaries & Pens</span>
      </a>

      <!-- 7. Apparel & T-Shirts -->
      <a href="/collections/all/apparel" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=180&q=80" alt="Apparel & Bags" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Apparel & Bags</span>
      </a>

      <!-- 8. Diwali & Festive -->
      <a href="/collections/all/festive" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1512909006721-3d6018887383?auto=format&fit=crop&w=180&q=80" alt="Diwali & Festive" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Diwali & Festive</span>
      </a>

      <!-- 9. Tech & Gadgets -->
      <a href="/collections/all/tech" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=180&q=80" alt="Tech Accessories" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Tech & Audio</span>
      </a>
    </div>
