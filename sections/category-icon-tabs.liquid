<section class="igp-category-circles-section">
  <div class="container">
    <div class="igp-section-heading">
      <h2>Explore Corporate Gifting Categories</h2>
      <p>Curated collections, handcrafted luxury hampers, and customizable brand merchandise</p>
    </div>

    <div class="igp-circles-scroll">
      <!-- 1. All Hampers -->
      <a href="/collections/all" class="igp-circle-card active">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=180&q=80" alt="All Hampers" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">All Hampers</span>
      </a>

      <!-- 2. Custom Boxes -->
      <a href="/#box-builder" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1513297887119-d46091b24bfa?auto=format&fit=crop&w=180&q=80" alt="Custom Boxes" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Build a Box</span>
      </a>

      <!-- 3. Employee Onboarding -->
      <a href="/collections/all/employee-onboarding" class="igp-circle-card">
        <div class="igp-circle-img-wrap">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=180&q=80" alt="Employee Onboarding" loading="lazy" width="80" height="80">
        </div>
        <span class="igp-circle-label">Onboarding Kits</span>
