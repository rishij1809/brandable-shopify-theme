<section class="mosaic-section">
  <div class="container">
    <div class="section-header-centered">
      <span class="section-tag">Curated Collections</span>
      <h2 class="section-title">Gifting Categories & Styles</h2>
      <p class="section-subtitle">
        Explore ready-curated luxury hampers or craft an entirely personalized gifting experience for your company.
      </p>
    </div>

    <div class="mosaic-layout">
      <!-- Large Feature Card (Left) -->
      <div class="mosaic-large-card">
        <img src="https://images.unsplash.com/photo-1513297887119-d46091b24bfa?auto=format&fit=crop&w=800&q=80" 
             alt="Custom Gift Box Builder" 
             loading="lazy" 
             width="800" 
             height="600">
        <div class="mosaic-card-badge">
          <h3>Custom Gift Box Builder</h3>
          <span>Select packaging, goodies, and upload your logo</span>
          <div>
            <a href="/#box-builder" class="badge-cta">Build Your Box &rarr;</a>
          </div>
        </div>
      </div>

      <!-- 4 Small Category Cards (Right) -->
      <div class="mosaic-small-grid">
        <div class="mosaic-small-card">
          <img src="https://images.unsplash.com/photo-1543257580-7269da773bf5?auto=format&fit=crop&w=500&q=80" 
               alt="Executive Hampers" 
               loading="lazy" 
               width="500" 
               height="350">
          <div class="mosaic-card-badge">
            <h3>Executive Hampers</h3>
            <span>Premium wines & goods</span>
            <div>
              <a href="/collections/all" class="badge-cta">Explore &rarr;</a>
            </div>
          </div>
        </div>

        <div class="mosaic-small-card">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=500&q=80" 
               alt="Employee Onboarding" 
               loading="lazy" 
               width="500" 
               height="350">
          <div class="mosaic-card-badge">
            <h3>Employee Welcome</h3>
            <span>Branded kits for new hires</span>
            <div>
              <a href="/collections/all" class="badge-cta">Explore &rarr;</a>
            </div>
          </div>
        </div>

        <div class="mosaic-small-card">
          <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=500&q=80" 
               alt="Artisan Treats" 
               loading="lazy" 
               width="500" 
               height="350">
          <div class="mosaic-card-badge">
            <h3>Artisan Sweets</h3>
            <span>Chocolates & coffees</span>
            <div>
              <a href="/collections/all" class="badge-cta">Explore &rarr;</a>
            </div>
          </div>
        </div>

        <div class="mosaic-small-card">
          <img src="https://images.unsplash.com/photo-1607344645866-009c320b5ab8?auto=format&fit=crop&w=500&q=80" 
               alt="Wellness & Relaxation" 
               loading="lazy" 
               width="500" 
               height="350">
          <div class="mosaic-card-badge">
            <h3>Wellness & Teas</h3>
            <span>Self-care for teams</span>
            <div>
              <a href="/collections/all" class="badge-cta">Explore &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections Mosaic",
  "settings": [],
  "presets": [
    {
      "name": "Featured Collections Mosaic"
    }
  ]
}
{% endschema %}

