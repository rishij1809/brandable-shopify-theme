        </div>
      {% endif %}
    </div>

    <div style="text-align: center; margin-top: 3rem;">
      <a href="/collections/all" class="btn-igp-primary" style="padding: 0.85rem 2.5rem; font-size: 0.95rem; display: inline-block; text-decoration: none;">
        View All Hampers & Gifts &rarr;
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}