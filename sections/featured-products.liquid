            </div>
            <div class="igp-delivery-pill"><span>⚡ Earliest Dispatch: Today</span> &bull; <span>Free Logo Engraving</span></div>
            <div class="igp-card-actions">
              <button type="button" class="btn-igp-basket-sm" onclick="openQuoteModal({ title: 'The Executive Reserve Luxury Hamper', price: '₹ 2,499' })">+ Basket</button>
              <button type="button" class="btn-igp-quote-sm" onclick="openQuoteModal({ title: 'The Executive Reserve Luxury Hamper', price: '₹ 2,499' })">Request Quote</button>
            </div>
          </div>
        </div>

        <div class="igp-product-card">
          <div class="igp-card-media">
            <span class="igp-badge-curated">Popular</span>
            <button type="button" class="igp-wishlist-icon" aria-label="Save" onclick="this.classList.toggle('active')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            </button>
            <a href="/collections/all" class="igp-card-img-link">
              <img src="https://images.unsplash.com/photo-1513297887119-d46091b24bfa?auto=format&fit=crop&w=600&q=80" alt="Artisan Gourmet Treats Crate">
            </a>
            <div class="igp-rating-badge"><span class="star-icon">★</span> 4.8 <span class="review-count">(195)</span></div>
          </div>
          <div class="igp-card-body">
