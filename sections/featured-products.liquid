<section class="igp-products-section">
  <div class="container">
    <div class="igp-section-heading">
      <h2>Bestselling Corporate Hampers & Gifts</h2>
      <p>Handpicked corporate collections ready for laser engraving and express dispatch</p>
    </div>

    <div class="igp-products-grid">
      {% assign count = 0 %}
      {% for product in collections.all.products limit: 8 %}
        {% unless product.tags contains 'custom:packaging' or product.tags contains 'custom:box_item' %}
          {% assign count = count | plus: 1 %}
          {% assign variant = product.selected_or_first_available_variant | default: product.variants.first %}
          
          <div class="igp-product-card">
            <!-- Media Container -->
            <div class="igp-card-media">
              <span class="igp-badge-curated">Bestseller</span>
              
              <button type="button" class="igp-wishlist-icon" aria-label="Save item" onclick="this.classList.toggle('active')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>

              <a href="{{ product.url }}" class="igp-card-img-link">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" 
                       alt="{{ product.title | escape }}" 
                       loading="lazy" 
                       width="300" 
                       height="300">
                {% else %}
                  <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=600&q=80" 
                       alt="{{ product.title | escape }}" 
                       loading="lazy" 
                       width="300" 
                       height="300">
                {% endif %}
              </a>

              <!-- Iconic IGP Rating Badge -->
              <div class="igp-rating-badge">
                <span class="star-icon">★</span> 4.8 <span class="review-count">(124)</span>
              </div>
            </div>

            <!-- Card Details -->
            <div class="igp-card-body">
              <h3 class="igp-card-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <div class="igp-price-row">
                <span class="igp-current-price">{{ product.price | money }}</span>
                <span class="igp-mrp-price">{{ product.price | times: 1.25 | money }}</span>
                <span class="igp-discount-tag">20% OFF</span>
              </div>

              <div class="igp-delivery-pill">
                <span>⚡ Earliest Dispatch: Today</span> &bull; <span>MOQ: 10 units</span>
              </div>

              <!-- Action Buttons -->
              <div class="igp-card-actions">
                <form action="/cart/add" method="post" class="igp-add-form">
                  <input type="hidden" name="id" value="{{ variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="btn-igp-basket-sm">+ Basket</button>
                </form>
                <button type="button" 
                        class="btn-igp-quote-sm" 
                        onclick="openQuoteModal({ title: {{ product.title | json }}, price: {{ product.price | money | json }} })">
                  Request Quote
                </button>
              </div>
            </div>
          </div>
        {% endunless %}
      {% endfor %}

      {% if count == 0 %}
        <!-- Demo Curated Hampers matching authentic IGP catalog style -->
        <div class="igp-product-card">
          <div class="igp-card-media">
            <span class="igp-badge-curated">Bestseller</span>
            <button type="button" class="igp-wishlist-icon" aria-label="Save" onclick="this.classList.toggle('active')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            </button>
            <a href="/collections/all" class="igp-card-img-link">
              <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=600&q=80" alt="The Executive Reserve Hamper">
            </a>
            <div class="igp-rating-badge"><span class="star-icon">★</span> 4.9 <span class="review-count">(340)</span></div>
          </div>
          <div class="igp-card-body">
            <h3 class="igp-card-title"><a href="/collections/all">The Executive Reserve Luxury Hamper</a></h3>
            <div class="igp-price-row">
              <span class="igp-current-price">₹ 2,499</span>
              <span class="igp-mrp-price">₹ 3,299</span>
