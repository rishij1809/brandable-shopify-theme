            </a>
            <div class="igp-rating-badge"><span class="star-icon">★</span> 4.9 <span class="review-count">(410)</span></div>
          </div>
          <div class="igp-card-body">
            <h3 class="igp-card-title"><a href="/collections/all">Tech & Drinkware Welcome Box</a></h3>
            <div class="igp-price-row">
              <span class="igp-current-price">₹ 1,999</span>
              <span class="igp-mrp-price">₹ 2,799</span>
              <span class="igp-discount-tag">28% OFF</span>
            </div>
            <div class="igp-delivery-pill"><span>⚡ Earliest Dispatch: 24h</span> &bull; <span>Flask & Diary Set</span></div>
            <div class="igp-card-actions">
              <button type="button" class="btn-igp-basket-sm" onclick="openQuoteModal({ title: 'Tech & Drinkware Welcome Box', price: '₹ 1,999' })">+ Basket</button>
              <button type="button" class="btn-igp-quote-sm" onclick="openQuoteModal({ title: 'Tech & Drinkware Welcome Box', price: '₹ 1,999' })">Request Quote</button>
