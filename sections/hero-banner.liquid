<section class="igp-hero-section">
  <div class="container">
    <div class="igp-hero-card">
      <!-- Left Content Column -->
      <div class="igp-hero-content">
        <div class="igp-hero-pill-badge">
          <span>✨</span> India's #1 B2B Corporate & Celebration Gifting Platform
        </div>
        
        <h1 class="igp-hero-title">
          Curated Corporate & <span class="text-highlight-red">Celebration Gifts</span>
        </h1>
        
        <p class="igp-hero-subtitle">
          Delight employees, clients, and partners with artisan gift boxes, laser-engraved luxury hampers, and custom-branded merchandise. Zero payment upfront &bull; Direct corporate invoicing.
        </p>

        <!-- Fast Action CTAs -->
        <div class="igp-hero-ctas">
          <a href="/collections/all" class="btn-igp-primary">
            Explore All Hampers &rarr;
          </a>
          <a href="/#box-builder" class="btn-igp-outline">
            Build Custom Box 📦
          </a>
        </div>

        <!-- Trust Features Strip (Iconic IGP Promises) -->
        <div class="igp-hero-trust-row">
          <div class="igp-trust-item">
            <span class="igp-trust-icon">⚡</span>
            <div>
              <strong>Pan-India Express</strong>
              <span>Same-day dispatch hubs</span>
            </div>
          </div>
          <div class="igp-trust-item">
            <span class="igp-trust-icon">🎨</span>
            <div>
              <strong>Free Logo Branding</strong>
              <span>Laser engraved on 25+ units</span>
            </div>
          </div>
          <div class="igp-trust-item">
            <span class="igp-trust-icon">🛡️</span>
            <div>
              <strong>Zero Upfront Cost</strong>
              <span>Pay on delivery approval</span>
            </div>
          </div>
        </div>

        <!-- Client Social Proof Cluster -->
        <div class="igp-social-proof">
          <div class="igp-avatar-group">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="Client 1">
            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80" alt="Client 2">
            <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=100&q=80" alt="Client 3">
          </div>
          <div class="igp-proof-text">
            <strong>Trusted by 1,200+ Corporate Brands</strong>
            <span class="igp-stars"><span class="star-green">★</span> 4.9/5 from 4,500+ Reviews</span>
          </div>
        </div>
      </div>

      <!-- Right Visual Column (IGP Curated Hamper Showcase) -->
      <div class="igp-hero-visual">
        <div class="igp-hero-image-wrap">
          <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=800&q=80" 
               alt="Luxury Corporate Gifting Hamper" 
               class="igp-hero-img" 
               loading="eager" 
               width="800" 
               height="600">
          <div class="igp-hero-floating-card">
            <div class="floating-card-icon">🎁</div>
            <div>
              <div class="floating-card-title">Executive Reserve Hamper</div>
              <div class="floating-card-sub">MOQ: 10 Units &bull; Custom Branded</div>
            </div>
            <button type="button" class="floating-quote-btn" onclick="openQuoteModal({ title: 'The Executive Reserve Hamper', price: '₹ 1,499' })">
              Quote
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Pill",
  "settings": [],
  "presets": [
    {
      "name": "Hero Banner Pill"
    }
  ]
}
{% endschema %}
