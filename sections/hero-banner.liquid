<section class="hero-banner-section">
  <div class="container">
    <div class="hero-content-wrapper">
      <div>
        <span class="hero-tag">✨ Corporate Gifting & Holiday Sale</span>
        <h1 class="hero-title">Custom Gift Boxes & Luxury Corporate Hampers</h1>
        <p class="hero-subtitle">
          Elevate your corporate relationships. Choose ready-to-ship luxury hampers or design custom branded gift boxes with full logo personalization. Zero payment upfront.
        </p>
        <div class="hero-btn-group">
          <a href="/#box-builder" class="btn btn-green">Build a Custom Box &rarr;</a>
          <a href="/collections/all" class="btn btn-crimson">Browse Hampers</a>
          <button type="button" class="btn btn-secondary" onclick="openQuoteModal()">Request Custom Quote</button>
        </div>
      </div>

      <div class="hero-image-box">
        <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=900&q=80" 
             alt="Luxury Corporate Gifting" 
             loading="eager" 
             width="900" 
             height="600">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}

