<section class="igp-showcase-section">
  <div class="container">
    <div class="igp-section-heading">
      <h2>Handpicked Gifting Collections</h2>
      <p>Exclusive corporate hampers, custom crates, and bespoke team gifts</p>
    </div>

    <div class="igp-spotlight-grid">
      <!-- Card 1: Executive Luxury -->
      <a href="/collections/all/executive-combos" class="igp-spotlight-card">
        <div class="spotlight-thumb">
          <img src="https://images.unsplash.com/photo-1543257580-7269da773bf5?auto=format&fit=crop&w=300&q=80" alt="Executive Hampers" loading="lazy">
        </div>
        <div class="spotlight-info">
          <span class="spotlight-tag">PREMIUM</span>
          <h3>Executive Hampers</h3>
          <p>Wine, artisan delicacies & laser-engraved keepsakes</p>
          <span class="spotlight-link">Explore Collection &rarr;</span>
        </div>
      </a>

      <!-- Card 2: Custom Box Builder -->
      <a href="/#box-builder" class="igp-spotlight-card highlight-card">
        <div class="spotlight-thumb">
          <img src="https://images.unsplash.com/photo-1513297887119-d46091b24bfa?auto=format&fit=crop&w=300&q=80" alt="Custom Gift Box Studio" loading="lazy">
        </div>
        <div class="spotlight-info">
          <span class="spotlight-tag tag-red">CUSTOM STUDIO</span>
          <h3>Build a Custom Box</h3>
          <p>Select your box style, goodies & corporate greeting card</p>
          <span class="spotlight-link">Start Building &rarr;</span>
        </div>
      </a>

      <!-- Card 3: Employee Onboarding -->
      <a href="/collections/all/employee-onboarding" class="igp-spotlight-card">
        <div class="spotlight-thumb">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=300&q=80" alt="Employee Onboarding" loading="lazy">
        </div>
        <div class="spotlight-info">
          <span class="spotlight-tag">HR FAVORITE</span>
          <h3>Employee Welcome Kits</h3>
          <p>Notebooks, insulated bottles, hoodies & tech swag</p>
          <span class="spotlight-link">View Kits &rarr;</span>
        </div>
      </a>

      <!-- Card 4: Artisan Treats -->
      <a href="/collections/all/gourmet" class="igp-spotlight-card">
        <div class="spotlight-thumb">
          <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=300&q=80" alt="Artisan Treats" loading="lazy">
        </div>
        <div class="spotlight-info">
          <span class="spotlight-tag">GOURMET</span>
          <h3>Artisan Delights</h3>
          <p>Handcrafted Belgian chocolates, dry fruits & gourmet teas</p>
          <span class="spotlight-link">Browse Treats &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
