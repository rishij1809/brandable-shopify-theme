<section class="pill-showcase-section">
  <div class="container">
    <div class="section-pill-header">
      <h2>Curated Gifting Collections</h2>
      <div class="dots-divider">
        <span></span><span></span><span></span>
      </div>
    </div>

    <div class="pill-cards-grid">
      <!-- Card 1: Rose Pill -->
      <a href="/collections/all" class="pill-card pill-card-rose">
        <div class="pill-card-img-wrap">
          <img src="https://images.unsplash.com/photo-1543257580-7269da773bf5?auto=format&fit=crop&w=160&q=80" alt="Executive Hampers">
        </div>
        <div class="pill-card-content">
          <h3>Executive Hampers</h3>
          <span class="pill-card-cta">Explore &rarr;</span>
        </div>
      </a>

      <!-- Card 2: Gold Pill -->
      <a href="/pages/box-builder" class="pill-card pill-card-gold">
        <div class="pill-card-img-wrap">
          <img src="https://images.unsplash.com/photo-1513297887119-d46091b24bfa?auto=format&fit=crop&w=160&q=80" alt="Custom Gift Boxes">
        </div>
        <div class="pill-card-content">
          <h3>Custom Gift Boxes</h3>
          <span class="pill-card-cta">Build Box &rarr;</span>
        </div>
      </a>

      <!-- Card 3: Slate Pill -->
      <a href="/collections/all" class="pill-card pill-card-slate">
        <div class="pill-card-img-wrap">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=160&q=80" alt="Employee Onboarding">
        </div>
        <div class="pill-card-content">
          <h3>Employee Kits</h3>
          <span class="pill-card-cta">Explore &rarr;</span>
        </div>
      </a>

      <!-- Card 4: Cocoa Pill -->
      <a href="/collections/all" class="pill-card pill-card-cocoa">
        <div class="pill-card-img-wrap">
          <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=160&q=80" alt="Artisan Sweets">
        </div>
        <div class="pill-card-content">
          <h3>Artisan Treats</h3>
          <span class="pill-card-cta">Explore &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Horizontal Pill Showcase",
  "settings": [],
  "presets": [
    {
      "name": "Horizontal Pill Showcase"
    }
  ]
}
{% endschema %}
