<section id="how-it-works" class="igp-how-it-works-section">
  <div class="container">
    <div class="igp-section-heading">
      <h2>How Corporate Gifting Works With Us</h2>
      <p>Seamless 3-step process designed for HR, marketing, and leadership teams</p>
    </div>

    <div class="igp-steps-grid">
      <div class="igp-step-card">
        <div class="igp-step-badge">1</div>
        <h3>Select or Build</h3>
        <p>
          Choose from our luxury pre-curated hampers, or use our interactive Custom Box Studio to handpick rigid packaging, drinkware, and artisan goodies.
        </p>
      </div>

      <div class="igp-step-card">
        <div class="igp-step-badge">2</div>
        <h3>Personalize & Quote</h3>
        <p>
          Zero payment upfront. Upload your corporate vector logo, choose greeting card messages, and indicate your target delivery timeline and quantity.
        </p>
      </div>

      <div class="igp-step-card">
        <div class="igp-step-badge">3</div>
        <h3>Free 3D Mockup & Ship</h3>
        <p>
          Our gifting concierge delivers a 3D digital branded proof and GST volume quotation in 24 hours. Once confirmed, we dispatch directly to recipients.
        </p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 3rem;">
      <button type="button" class="btn-igp-primary" style="padding: 0.9rem 2.5rem; font-size: 1rem;" onclick="openQuoteModal()">
        Start Your Corporate Inquiry &rarr;
      </button>
    </div>
  </div>
</section>

{% schema %}
