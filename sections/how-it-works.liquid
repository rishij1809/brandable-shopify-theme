<section id="how-it-works" class="how-it-works-section">
  <div class="container">
    <div class="section-header-centered">
      <span class="section-tag">Simple & Streamlined</span>
      <h2 class="section-title">How Corporate Gifting Works With Us</h2>
      <p class="section-subtitle">
        We make corporate gifting effortless for HR, marketing, and executive teams.
      </p>
    </div>

    <div class="steps-grid">
      <div class="step-card">
        <div class="step-num">1</div>
        <h3>Select or Build</h3>
        <p>
          Pick from our curated catalog of pre-made executive hampers, or use our interactive Box Builder to hand-pick custom packaging and contents.
        </p>
      </div>

      <div class="step-card">
        <div class="step-num">2</div>
        <h3>Submit Quote & Branding</h3>
        <p>
          Zero payment upfront. Simply tell us your estimated order quantity (MOQ), target event date, and upload your company logo or custom message.
        </p>
      </div>

      <div class="step-card">
        <div class="step-num">3</div>
        <h3>Review Mockup & Ship</h3>
        <p>
          Our concierge prepares a 3D digital branded proof and tiered volume pricing within 24 hours. Upon approval, we handle worldwide drop-shipping.
        </p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 3rem;">
      <button type="button" class="btn btn-green" onclick="openQuoteModal()">
        Start Your Corporate Inquiry &rarr;
      </button>
    </div>
  </div>
</section>

{% schema %}
