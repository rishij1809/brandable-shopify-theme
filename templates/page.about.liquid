{% comment %}
  Brandable About Us Page Template
{% endcomment %}

<div class="container">
  <div class="page-hero-banner">
    <span class="hero-pill-badge" style="background: rgba(255,255,255,0.25);">Our Mission & Story</span>
    <h1>Elevating Corporate Gifting</h1>
    <p>We help innovative companies show appreciation to clients, executive partners, and remote teams through bespoke curated gift boxes.</p>
  </div>

  <div class="about-features-grid">
    <div class="about-feature-card">
      <div class="about-feature-icon">✨</div>
      <h3>100% In-House Branding</h3>
      <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">
        From custom laser-engraved wooden lids to debossed leather and personalized foil-stamped greeting cards, every box is crafted to reflect your brand identity.
      </p>
    </div>

    <div class="about-feature-card">
      <div class="about-feature-icon">🛡️</div>
      <h3>Zero Payment Upfront</h3>
      <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">
        Our lead-first model means you receive full digital 3D mockups and itemized tiered volume quotes before committing a single dollar.
      </p>
    </div>

    <div class="about-feature-card">
      <div class="about-feature-icon">🚀</div>
      <h3>Multi-Address Drop Shipping</h3>
      <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">
        Simply provide your recipient spreadsheet. We handle individual white-glove packaging, tracking, and delivery directly to domestic and international doorsteps.
      </p>
    </div>
  </div>

  <!-- Corporate Impact Numbers -->
  <div style="background: #ffffff; border-radius: var(--radius-card); padding: 3rem 2rem; border: 1px solid var(--color-border); text-align: center; margin-bottom: 4rem;">
    <h2 style="font-size: 1.8rem; margin: 0 0 2rem 0; color: var(--color-text-dark);">Brandable By The Numbers</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
      <div>
        <div style="font-size: 2.8rem; font-weight: 800; color: var(--color-coral-dark);">50,000+</div>
        <div style="color: var(--color-text-muted); font-weight: 600;">Custom Boxes Delivered</div>
      </div>
      <div>
        <div style="font-size: 2.8rem; font-weight: 800; color: var(--color-coral-dark);">1,200+</div>
        <div style="color: var(--color-text-muted); font-weight: 600;">Corporate Clients Worldwide</div>
      </div>
      <div>
        <div style="font-size: 2.8rem; font-weight: 800; color: var(--color-coral-dark);">99.8%</div>
        <div style="color: var(--color-text-muted); font-weight: 600;">On-Time Event Delivery</div>
      </div>
    </div>

    <div style="margin-top: 2.5rem;">
      <button type="button" class="btn btn-primary" onclick="openQuoteModal()">
        Partner With Our Gifting Team &rarr;
      </button>
    </div>
  </div>
</div>

