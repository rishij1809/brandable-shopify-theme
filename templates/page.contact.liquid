{% comment %}
  Brandable Contact & Corporate Inquiry Page Template
{% endcomment %}

<div class="container">
  <div class="page-hero-banner">
    <span class="hero-pill-badge" style="background: rgba(255,255,255,0.25);">Get in Touch</span>
    <h1>Corporate Gifting Concierge</h1>
    <p>Tell us about your upcoming event, client campaign, or team milestone. We will prepare custom proposals and tiered quotes.</p>
  </div>

  <div class="contact-layout-grid">
    <!-- Left: Inquiry Form -->
    <div class="contact-form-panel">
      <h2 style="margin-top: 0; font-size: 1.5rem; color: var(--color-text-dark);">Submit a Project Inquiry</h2>
      <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 2rem;">
        Fill in your requirements and a gifting specialist will respond within 24 hours.
      </p>

      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div class="notice-success">
            <strong>Inquiry Received!</strong><br>
            Thank you for reaching out. A corporate gifting concierge will review your project details and follow up shortly.
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="notice-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-grid-2">
          <div class="form-group">
            <label for="ContactFormName">Contact Name *</label>
            <input type="text" id="ContactFormName" name="contact[name]" placeholder="Jane Doe" required>
          </div>
          <div class="form-group">
            <label for="ContactFormCompany">Company Name *</label>
            <input type="text" id="ContactFormCompany" name="contact[Company]" placeholder="Acme Inc." required>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label for="ContactFormEmail">Business Email *</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="jane@acme.com" required>
          </div>
          <div class="form-group">
            <label for="ContactFormPhone">Phone Number *</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="+1 (555) 012-3456" required>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label for="ContactFormMOQ">Estimated Units Needed *</label>
            <input type="number" id="ContactFormMOQ" name="contact[Quantity]" placeholder="e.g. 50" min="1" required>
          </div>
          <div class="form-group">
            <label for="ContactFormDate">Target Delivery Date *</label>
            <input type="date" id="ContactFormDate" name="contact[Delivery Date]" required>
          </div>
        </div>

        <div class="form-group">
          <label for="ContactFormMessage">Project Notes / Custom Branding Details</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="5" placeholder="Share box style preferences, custom greeting card messages, or budget range per box..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1rem;">
          Submit Inquiry to Concierge &rarr;
        </button>
      {% endform %}
    </div>

    <!-- Right: Concierge Contact Info -->
    <div class="contact-info-panel">
      <h3>Direct Concierge Support</h3>
      <p style="color: #ced4da; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
        Prefer to speak directly with our senior corporate gifting team? We are available Monday through Friday.
      </p>

      <div style="margin-bottom: 1.5rem;">
        <strong style="color: #ffffff; display: block; margin-bottom: 0.25rem;">📧 Corporate Email</strong>
        <span style="color: #ced4da;">concierge@brandable.example.com</span>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <strong style="color: #ffffff; display: block; margin-bottom: 0.25rem;">📞 Direct Phone Line</strong>
        <span style="color: #ced4da;">+1 (800) 555-GIFT / +1 (555) 019-2834</span>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <strong style="color: #ffffff; display: block; margin-bottom: 0.25rem;">⏰ Concierge Hours</strong>
        <span style="color: #ced4da;">Monday &ndash; Friday: 8:00 AM &ndash; 7:00 PM EST</span>
      </div>

      <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #343a40;">
        <strong style="color: #ffffff; display: block; margin-bottom: 0.5rem;">Have Active Items in Basket?</strong>
        <p style="font-size: 0.85rem; color: #adb5bd; margin-bottom: 1rem;">
          You can also submit your quote directly through our interactive Quote Basket.
        </p>
        <a href="/cart" class="btn btn-secondary" style="color: #000; padding: 0.6rem 1.2rem; font-size: 0.85rem;">
          View Quote Basket &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

